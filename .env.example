# Copy to .env and fill in. Never commit .env.

# Nebius Token Factory (OpenAI-compatible). Confirm the base URL in your Token Factory console.
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1/
NEBIUS_API_KEY=

# Comma-separated model IDs to compare. Check exact IDs with: uv run scripts/test_models.py --list
CANDIDATE_MODELS=Qwen/Qwen3-235B-A22B-Instruct-2507,meta-llama/Llama-3.3-70B-Instruct,deepseek-ai/DeepSeek-V3-0324

# LangSmith
LANGSMITH_API_KEY=
LANGSMITH_TRACING=true
LANGSMITH_PROJECT=sc-dataset-agent

# NCBI E-utilities (raises GEO rate limit from 3 to 10 req/s)
NCBI_API_KEY=
NCBI_EMAIL=

# Local Postgres (matches docker-compose.yml)
DATABASE_URL=postgresql://agent:agent@localhost:5432/agent
